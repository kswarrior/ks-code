{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Modern Blue",
  "id": "modern-blue",
  "light": {
    "palette": {
      "neutral": "#f8f9fa",
      "ink": "#001f3f",
      "primary": "#007bff",
      "accent": "#0056b3",
      "success": "#28a745",
      "warning": "#ffc107",
      "error": "#dc3545",
      "info": "#17a2b8"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#000000",
      "ink": "#ffffff",
      "primary": "#0088ff",
      "accent": "#00c3ff",
      "success": "#00ff88",
      "warning": "#ffea00",
      "error": "#ff1744",
      "info": "#18ffff"
    },
    "overrides": {
      "syntax-comment": "#5c6b7d",
      "syntax-keyword": "#00c3ff",
      "syntax-string": "#00ff88",
      "syntax-primitive": "#ffea00",
      "syntax-variable": "#ffffff",
      "syntax-property": "#0088ff",
      "syntax-type": "#00c3ff",
      "syntax-constant": "#ff1744",
      "syntax-operator": "#0088ff",
      "syntax-punctuation": "#ffffff",
      "syntax-object": "#ffffff"
    }
  }
}
